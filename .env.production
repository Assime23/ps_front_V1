# Variables d'environnement pour la production
REACT_APP_API_URL=https://api1.psmyservices.com
REACT_APP_API_BASE_URL=https://api1.psmyservices.com/api

# Nom de l'application
REACT_APP_NAME="Papou Service"

# Mode de débogage (false en production)
REACT_APP_DEBUG=false

# Autres configurations spécifiques à votre application
REACT_APP_COMPANY_NAME="Papou Service"
REACT_APP_VERSION=1.0.0

# Configuration CORS (si nécessaire côté frontend)
REACT_APP_CORS_ORIGIN=https://psmyservices.com

# Configuration des cookies (si utilisés)
REACT_APP_COOKIE_DOMAIN=.psmyservices.com

# Timeout des requêtes API (en millisecondes)
REACT_APP_API_TIMEOUT=30000

# Clé pour le stockage local (préfixe)
REACT_APP_STORAGE_PREFIX=ps_app_
